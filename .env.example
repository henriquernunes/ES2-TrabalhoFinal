# moodle
MOODLE_PORT=8080
# url dos links nos emails, também é o wwwroot do moodle
MOODLE_PUBLIC_URL=http://localhost:8080
# url que o acompanhamento usa pra chamar o rest (rede do compose)
MOODLE_URL=http://moodle:8080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin#2026
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle
# o make seed preenche esses dois
MOODLE_TOKEN=
MOODLE_COURSE_ID=2
MOODLE_TIMEOUT_MS=10000

# spring cloud
EUREKA_PORT=8761
GATEWAY_PORT=9000

# acompanhamento
ACOMPANHAMENTO_PORT=8081
# intervalo do ciclo em segundos (na demo usar 30-60)
POLL_INTERVAL_SECONDS=3600
REMINDER_WINDOW_HOURS=24

# rabbitmq
RABBITMQ_USER=reengajamento
RABBITMQ_PASSWORD=reengajamento

# notificacoes
NOTIFICACOES_PORT=8082
NOTIFICACOES_DB_NAME=notificacoes
NOTIFICACOES_DB_USER=notificacoes
NOTIFICACOES_DB_PASSWORD=notificacoes
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Moodle Reengajamento <nao-responda@example.com>"
SMTP_TIMEOUT_MS=5000
MAX_RETRIES=5
# atraso da 1a retentativa, dobra a cada vez (5s, 10s, 20s...)
RETRY_BASE_DELAY_MS=5000
